---
import Layout from '../../layouts/Layout.astro';
import { estimateRevenue } from '../../lib/revenue';
import RevenueCalculator from '../../components/RevenueCalculator.astro';
import { loadBids, bidChart, loadStorage, loadTariff, tariffValues } from '../../lib/market';
import { loadData } from '../../lib/data';
import { link } from '../../lib/links';
const bids = loadBids();
const bidSeries = [{ key: 'system' as const, label: '2h 储能系统', color: '#282437' }, { key: 'epc' as const, label: '2h EPC（不含 PC）', color: '#9c83c5' }].map(s => ({ ...s, ...bidChart(bids.series, s.key) }));
const latestBid = bids.series.filter(p => p.system !== null || p.epc !== null).at(-1)!;
const events = loadData().entries.filter(e => ['d5be65db09220d6d0e45f32901f54d7ea37bfd05c82474c290453e5cf0d7edae', 'fe10ffb6bf743afacca6a333369128ba2832c60207351b6e089911d2eddafdac'].includes(e.policy.id) && e.date >= '2024-12-31' && e.date <= '2026-06-30').sort((a,b) => a.date.localeCompare(b.date));
const storageX = (date: string) => 100 + (Date.parse(date) - Date.parse('2024-12-31')) / (Date.parse('2026-06-30') - Date.parse('2024-12-31')) * 420;
const storage = loadStorage();
const latestStorage = storage.series.at(-1)!;
const storageMax = Math.ceil(Math.max(...storage.series.map(p => p.power)) * 2) / 2;
const storagePoints = storage.series.map(p => ({ ...p, x: storageX(p.date), y: 235 - p.power / storageMax * 185 }));
const storagePath = storagePoints.map((p, i) => `${i ? 'L' : 'M'}${p.x},${p.y}`).join(' ');
const tariff = loadTariff();
const tariffRows = tariff.series.map(p => ({ ...p, ...tariffValues(p) }));
const latestTariff = tariffRows.at(-1)!;
const defaultPayback = estimateRevenue({ peak: latestTariff.peak, flat: latestTariff.flat, valley: latestTariff.valley, efficiency: .85, depth: .9, days: 300, cycles: 2, cost: latestBid.epc! }).payback;
const previousTariff = tariffRows.at(-2)!;
const tariffDelta = latestTariff.peakSpread - previousTariff.peakSpread;
const tariffPct = tariffDelta / previousTariff.peakSpread * 100;
const tariffY = (value: number) => 245 - (value - 0.7) / 0.6 * 200;
const tariffPoints = tariffRows.map((p, i) => ({ ...p, x: 80 + i * 104 }));
const tariffPath = tariffPoints.map((p, i) => `${i ? 'L' : 'M'}${p.x},${tariffY(p.peakSpread)}`).join(' ');
---
<Layout title="市场看板">
  <section class="hero"><div><p class="eyebrow">MARKET WATCH / 市场看板</p><h1>储能市场观察</h1><p class="muted">聚焦广东工商业储能收益，并跟踪全国储能成本与规模。独立储能的现货和调频收益暂未纳入。</p></div></section>
  <section class="market-metrics" aria-label="市场指标">
    <article class="metric"><span>广东峰谷价差 · 高峰−低谷</span><strong>{latestTariff.peakSpread.toFixed(4)}<small>元/千瓦时</small></strong><p>数据月份：{latestTariff.month}</p><p class="change">较上月{tariffDelta < 0 ? '下降' : '上升'} {Math.abs(tariffDelta).toFixed(4)} 元/千瓦时（{tariffPct > 0 ? '+' : ''}{tariffPct.toFixed(2)}%）</p></article>
    <article class="metric"><span>全国 2h EPC 中标均价</span><strong>{latestBid.epc?.toFixed(4)}<small>元/Wh</small></strong><p>数据月份：{latestBid.month} · 不含 PC</p><p>全国大型储能项目，不代表广东价格</p></article>
    <article class="metric"><span>两充两放静态回收期 · 粗算</span><strong>{defaultPayback?.toFixed(2) ?? '—'}<small>年</small></strong><p>默认参数 · {latestTariff.month} 电价</p><p>效率 85% · 放电深度 90% · 300 天/年<br />EPC {latestBid.epc?.toFixed(4)} 元/Wh</p><p><a href="#revenue-title">查看两种策略的测算</a></p></article>
  </section>
  <section class="market-charts" aria-label="市场趋势">
    <article class="trend tariff"><div class="section-title"><h2>① 收益：广东峰谷价差</h2><span class="fine">2026 年 5—10 月 · 元/千瓦时</span></div>
      <p class="tariff-legend"><span>● ━ 高峰−低谷</span><span>◆ 尖峰−低谷（7—9 月）</span></p>
      <div class="chart-viewport" tabindex="0" role="region" aria-label="峰谷价差图，可横向滚动"><svg class="tariff-chart" viewBox="0 0 680 300" role="img" aria-labelledby="tariff-title tariff-description">
        <title id="tariff-title">广东六个月峰谷价差</title><desc id="tariff-description">主线为高峰减低谷价差，10 月为 0.8913 元/千瓦时；菱形辅助点仅展示 7、8、9 月尖峰减低谷价差。纵轴从 0.7 起，完整数据见下表。</desc>
        <rect x="236" y="40" width="312" height="205" fill="#ebe4f8" opacity="0.7"><title>7—9 月：尖峰整月执行期（依据广东分时电价政策）</title></rect>
        {[0.7, 0.9, 1.1, 1.3].map(value => <g><line x1="80" x2="600" y1={tariffY(value)} y2={tariffY(value)} stroke="#e9e4f1"/><text x="55" y={tariffY(value) + 6} text-anchor="end">{value.toFixed(1)}</text></g>)}
        <path d={tariffPath} fill="none" stroke="#282437" stroke-width="3" vector-effect="non-scaling-stroke"/>
        {tariffPoints.map(p => <g><circle cx={p.x} cy={tariffY(p.peakSpread)} r="5" fill="#282437"><title>{p.month} 高峰−低谷：{p.peakSpread.toFixed(4)} 元/千瓦时</title></circle><text x={p.x} y="285" text-anchor="middle">{p.month.slice(5)} 月</text>{p.sharpSpread !== null && <path d={`M${p.x},${tariffY(p.sharpSpread)-7} l7,7 l-7,7 l-7,-7 Z`} fill="#9c83c5"><title>{p.month} 尖峰−低谷：{p.sharpSpread.toFixed(4)} 元/千瓦时</title></path>}</g>)}
      </svg></div>
      <p class="chart-caption">图表注释：7—9 月尖峰执行期间，尖峰−低谷价差均超过 1.1 元/千瓦时。</p>
      <p class="chart-scroll-hint">左右滑动查看完整图表</p>
      <p class="fine">浅色阴影（7—9 月）：尖峰整月执行期（依据广东分时电价政策）。</p>
      <details class="data-details"><summary>数据与口径</summary>
      <p class="fine">{tariff.sharp_note}“待核实”不代表“未执行”。</p>
      <div class="tariff-table" role="region" aria-label="六个月电价和公告，可横向滚动" tabindex="0"><table><caption>分时电量电价与价差（元/千瓦时，可横向滚动）</caption><thead><tr><th scope="col">月份</th><th scope="col">尖峰</th><th scope="col">高峰</th><th scope="col">平段</th><th scope="col">低谷</th><th scope="col">高峰−低谷</th><th scope="col">尖峰−低谷</th><th scope="col">列有尖峰 / 执行状态</th><th scope="col">来源</th></tr></thead><tbody>{tariffRows.map(p => <tr><th scope="row">{p.month}</th><td>{p.sharp.toFixed(4)}</td><td>{p.peak.toFixed(4)}</td><td>{p.flat.toFixed(4)}</td><td>{p.valley.toFixed(4)}</td><td>{p.peakSpread.toFixed(4)}</td><td>{p.sharpSpread === null ? '—' : p.sharpSpread.toFixed(4)}</td><td>{p.sharp_listed ? '是' : '否'} / {p.sharp_execution === 'full_month' ? '整月执行' : '待核实'}</td><td><a href={p.source_url} target="_blank" rel="noopener noreferrer">官方公告</a></td></tr>)}</tbody></table></div>
      <div class="chart-notes"><p><b>数据来源：</b>广东电网在南网在线发布的每月代理购电完整公告，经逐份核对录入；原单位分/千瓦时除以 100，保留四位小数。价差按未舍入的原始值计算。</p><p><b>统计口径：</b>{tariff.scope}</p><p><b>价区变化：</b>{tariff.zone_note}</p><p><b>尖峰执行条件（各月公告原文）：</b>{tariff.sharp_condition}</p></div>
      </details>
    </article>
    <article class="trend bids"><div class="section-title"><h2>② 成本：全国 2h 储能系统与 EPC 中标均价</h2><span class="fine">2025 年 9 月—2026 年 8 月 · 元/Wh</span></div>
      <p class="tariff-legend"><span>● ━ 2h 储能系统</span><span>◆ ━ 2h EPC（不含 PC）</span></p>
      <div class="bid-scroll" role="region" aria-label="中标均价趋势，可横向滚动" tabindex="0">
      <svg class="bid-chart" viewBox="0 0 790 340" aria-labelledby="bid-title bid-description">
        <title id="bid-title">全国 2h 系统与 EPC 中标均价</title><desc id="bid-description">12 个月中 6 个月有数据，缺失月份断开连线；1 月、5 月为孤立数据点。点击数据点打开 CNESA 原文，完整数值与出处见下表。</desc>
        {[0,0.35,0.7,1.05,1.4].map(v => <g><line x1="65" x2="725" y1={245-v/1.4*210} y2={245-v/1.4*210} stroke="#e9e4f1"/><text x="52" y={250-v/1.4*210} text-anchor="end">{v.toFixed(2)}</text></g>)}
        {bidSeries.map(series => <g><path d={series.path} fill="none" stroke={series.color} stroke-width="2.5"/>{series.points.map(p => <a href={p.source_url!} target="_blank" rel="noopener noreferrer" aria-label={`${p.month} ${series.label} ${p.value!.toFixed(4)} 元/Wh，查看 CNESA 原文`}><title>{p.month} · {series.label}：{p.value!.toFixed(4)} 元/Wh · 原文：{p.source_url}</title><circle cx={p.x} cy={p.y!} r="13" fill="transparent"/>{series.key === 'system' ? <circle cx={p.x} cy={p.y!} r="5" fill={series.color}/> : <path d={`M${p.x},${p.y!-7} l7,7 l-7,7 l-7,-7 Z`} fill={series.color}/>}</a>)}</g>)}
        {bids.series.map((p,i) => <text class="bid-date" x={65+i*60} y="276" text-anchor="end" transform={`rotate(-40 ${65+i*60} 276)`}>{p.month}</text>)}
      </svg></div>
      <p class="chart-caption">图表注释：{latestBid.month}，2h 系统与 EPC 中标均价分别为 {latestBid.system?.toFixed(4)}、{latestBid.epc?.toFixed(4)} 元/Wh。</p>
      <p class="chart-scroll-hint">左右滑动查看完整图表</p>
      <p class="fine">缺失月份留空并断线；圆点为系统，菱形为 EPC。悬停查看数值与原文链接，点击数据点打开原文；手机端也可查阅下表。</p>
      <details class="data-details"><summary>数据与口径</summary>
      <div class="bid-scroll"><table><caption>月度均价与原文（元/Wh）</caption><thead><tr><th>月份</th><th>2h 系统</th><th>2h EPC（不含 PC）</th><th>数据来源</th></tr></thead><tbody>{bids.series.map(p => <tr><th scope="row">{p.month}</th><td>{p.system?.toFixed(4) ?? '—'}</td><td>{p.epc?.toFixed(4) ?? '—'}</td><td>{p.source_url ? <a href={p.source_url} target="_blank" rel="noopener noreferrer">CNESA 月度正文</a> : '未取得可核实数值'}</td></tr>)}</tbody></table></div>
      <details class="storage-evidence"><summary>查看各月原文数值摘录</summary>{bids.series.filter(p => p.source_url).map(p => <div><p><a href={p.source_url!} target="_blank" rel="noopener noreferrer">{p.month} 原文</a> · EPC 小标题或正文明确不含 PC</p>{p.evidence.map(sentence => <blockquote>{sentence}</blockquote>)}</div>)}</details>
      <div class="chart-notes"><p>{bids.note.slice(bids.note.indexOf("另据"))} <a href={bids.half_year_url} target="_blank" rel="noopener noreferrer">CNESA 上半年报告原文</a></p><p>各月正文单位元/kWh，除以 1000 转为元/Wh；半年均价仅作补充说明，未作为月度数据点。</p></div>
      </details>
    </article>
    <RevenueCalculator />
    <article class="trend storage"><div class="section-title"><h2>④ 背景：全国新型储能累计装机</h2><span class="fine">半年度 · 功率（亿千瓦）</span></div>
      <div class="chart-viewport" tabindex="0" role="region" aria-label="装机趋势图，可横向滚动"><svg class="storage-chart" viewBox="0 0 600 295" role="img" aria-labelledby="storage-title storage-description">
        <title id="storage-title">全国新型储能累计装机规模半年度趋势</title><desc id="storage-description">2024 年底至 2026 年 6 月底四个半年度累计值，功率分别为 0.74、0.95、1.36、1.53 亿千瓦。原文精度、储能容量与出处见下表。</desc>
        {[0, 1, 2, 3, 4].map(i => <g><line x1="100" x2="520" y1={235 - i * 46.25} y2={235 - i * 46.25} stroke="#e9e4f1"/><text x="55" y={241 - i * 46.25} text-anchor="end">{(storageMax * i / 4).toFixed(2)}</text></g>)}
        {events.map((e, i) => <a href={link(`policies/${e.policy.id}/`)} aria-label={`${e.date} ${e.policy.title}`}><title>{e.date} · {e.policy.title}（点击查看政策）</title><line x1={storageX(e.date)} x2={storageX(e.date)} y1="45" y2="235" stroke="#a394bd" stroke-width="2"/><line x1={storageX(e.date)} x2={storageX(e.date)} y1="35" y2="240" stroke="transparent" stroke-width="22"/><text x={storageX(e.date)} y="28" text-anchor="middle">政策 {i + 1}</text></a>)}
        <path d={storagePath} fill="none" stroke="#282437" stroke-width="3" vector-effect="non-scaling-stroke"/>
        {storagePoints.map(p => <g><circle cx={p.x} cy={p.y} r="6" fill="#282437"><title>{p.label}：{p.original_power} / {p.original_energy}</title></circle><text x={p.x} y={p.y - 16} text-anchor="middle">{p.power.toFixed(2)}</text><text x={p.x} y="273" text-anchor="middle">{p.date.slice(0, 7)}</text></g>)}
      </svg></div>
      <p class="chart-caption">图表注释：截至 {latestStorage.date}，全国累计装机 {latestStorage.power.toFixed(2)} 亿千瓦 / {latestStorage.energy.toFixed(2)} 亿千瓦时，<a href={latestStorage.source_url} target="_blank" rel="noopener noreferrer">{latestStorage.official_yoy}</a>（官方公布）。</p>
      <p class="chart-scroll-hint">左右滑动查看完整图表</p>
      <details class="data-details"><summary>数据与口径</summary>
      <ul class="policy-events">{events.map((e, i) => <li><a href={link(`policies/${e.policy.id}/`)}>政策 {i + 1} · {e.date} · {e.policy.title}</a></li>)}</ul>
      <div class="storage-table"><table><caption>官方原文数值与来源</caption><thead><tr><th scope="col">截至时点</th><th scope="col">功率 / 储能容量（原文）</th><th scope="col">来源</th></tr></thead><tbody>{storage.series.map(p => <tr><th scope="row">{p.label}</th><td>{p.original_power}<br />{p.original_energy}</td><td><a href={p.source_url} target="_blank" rel="noopener noreferrer">国家能源局<br />{p.source_date}</a></td></tr>)}</tbody></table></div>
      <details class="storage-evidence"><summary>查看四次发布会原文依据</summary>{storage.series.map(p => <div><p><b>{p.label}</b> · <a href={p.source_url} target="_blank" rel="noopener noreferrer">发布会原文</a></p><blockquote>{p.evidence}</blockquote></div>)}</details>
      <div class="chart-notes"><p><b>广东装机：</b>截至 2025 年底，广东新型储能装机规模超过 500 万千瓦（国家能源局未公布确切数值）。<a href="https://www.nea.gov.cn/20260130/50f657ce87f848e1a9a1861d1fd9aa23/c.html" target="_blank" rel="noopener noreferrer">国家能源局原文</a></p><p><b>数据来源：</b>{storage.note}</p><p><b>统计口径：</b>{storage.metric}，功率单位为亿千瓦，同时列示储能容量（亿千瓦时）。功率展示保留两位小数，表格保留原文数值；指标卡同比引用官方原文。</p></div>
      </details>
    </article>
  </section>
  <section class="methods"><h2>方法与局限</h2>
    <p><b>广东电价：</b>{tariff.sharp_note}公告列出尖峰价格不等于当月实际执行。纵轴从 0.7 起；价差不等于储能净收益，未计效率、费用等因素。后续月份需核对公告后更新。</p>
    <p><b>全国中标均价：</b>{bids.note.slice(0, bids.note.indexOf('另据'))}</p>
    <p><b>累计装机：</b>累计规模不代表当期新增或实际调用能力。仅录入已核对的官方确切数值，不估算缺失时点；数据经核对后更新。</p>
    <p><b>收益粗算：</b>示意性粗算。投资单价为全国大型储能项目口径，不含用户侧，工商业项目实际成本可能不同；未计入运维、电池衰减、合同能源管理分成、需量电费、尖峰电价等因素。</p>
  </section>
</Layout>
<style>
  .tariff{border-top:2px solid #282437!important}.bids{border-top:2px solid #9c83c5!important}.storage{border-top:2px solid #aca3ba!important}.takeaway{font-size:15px;line-height:1.8;color:#282437;margin:18px 0}.data-details{border-top:1px solid var(--line);margin-top:20px;padding-top:14px}.data-details>summary{cursor:pointer;color:#282437;font-weight:600}.methods{padding:26px;margin-top:24px;border-radius:28px;background:#eeebf6;color:var(--muted);font-size:14px;line-height:1.9}.methods h2{color:#282437;font-size:20px}.bid-chart{height:auto}.bid-chart text{font-size:14px}

  .bids{grid-column:1/-1}.bid-scroll{max-width:100%;overflow-x:auto}.bid-chart{display:block;width:100%;min-width:0;max-width:1000px;margin:auto}.bid-chart text{font-size:14px;fill:#858093}.bid-scroll table{min-width:520px;font-size:14px;font-variant-numeric:tabular-nums}.bid-scroll caption{text-align:left}.policy-events{font-size:14px;line-height:1.8;padding-left:20px}.policy-events li{margin:8px 0}svg a:focus-visible{outline:2px solid #9c83c5}

  .tariff{grid-column:1/-1}.tariff-chart{display:block;width:100%;max-width:900px;margin:15px auto;height:auto}.tariff-chart text{font-size:18px;fill:#858093;font-variant-numeric:tabular-nums}.tariff-legend{display:flex;gap:20px;flex-wrap:wrap;font-size:14px;color:#282437}.tariff-legend span:last-child{color:#9c83c5}.tariff-table{max-width:100%;overflow-x:auto}.tariff-table table{min-width:820px;font-size:14px;white-space:nowrap;font-variant-numeric:tabular-nums}.tariff-table caption{text-align:left;color:var(--muted);padding:10px 0}.tariff-table:focus-visible{outline:2px solid #282437}.tariff-table td,.tariff-table th{text-align:right}.tariff-table th:first-child{text-align:left}
  @media(max-width:760px){.bid-chart text{font-size:20px}.tariff-chart text{font-size:24px}.tariff-legend{gap:8px 16px}}

  .storage{grid-column:1/-1}.storage-chart{display:block;width:100%;max-width:600px;margin:20px auto;height:auto}.storage-chart text{font-size:17px;fill:#858093;font-variant-numeric:tabular-nums}.metric .storage-energy{font-size:18px;color:#282437}.storage-table table{table-layout:fixed}.storage-table th,.storage-table td{min-width:0;overflow-wrap:anywhere;text-align:left}.storage-table caption{text-align:left;color:var(--muted);padding:12px 0}.storage-evidence{margin-top:16px}.storage-evidence p{font-size:14px}.storage-evidence blockquote{margin-bottom:20px}
  @media(max-width:760px){.storage-table th,.storage-table td{padding:9px 5px;font-size:14px}.storage-chart text{font-size:22px}}
  .trend{min-width:0;overflow-wrap:anywhere}

  .market-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-bottom:28px}.metric,.trend{background:white;border:1px solid transparent;border-radius:28px;padding:26px}.metric>span{font-size:14px;color:var(--muted)}.metric strong{display:block;font-size:32px;color:#282437;margin:18px 0 10px;font-variant-numeric:tabular-nums}.metric strong.pending{font-size:25px;color:var(--muted)}.metric small{font-size:14px;margin-left:9px;font-weight:400}.metric p{font-size:14px;color:var(--muted);margin:8px 0;line-height:1.6}.metric .change{font-size:14px}.metric .up{color:#a42e39}.metric .down{color:#147154}.market-charts{display:grid;grid-template-columns:1fr;gap:24px}.chart-placeholder{min-height:190px;display:grid;place-items:center;background:repeating-linear-gradient(to bottom,#fafbfd 0,#fafbfd 46px,#eaf0f5 47px,#fafbfd 48px);color:var(--muted);border-radius:20px;font-size:18px}.chart-notes{border-top:1px solid var(--line);margin-top:22px;padding-top:12px;font-size:14px;line-height:1.9;color:var(--muted)}.chart-notes p{margin:8px 0}table{width:100%;border-collapse:collapse;margin-top:12px}th,td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--line)}th:last-child,td:last-child{text-align:right}.section-title{flex-wrap:wrap}.section-title h2{margin:0}
